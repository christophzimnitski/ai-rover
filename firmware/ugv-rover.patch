diff --git a/General_Driver/IMU_ctrl.h b/General_Driver/IMU_ctrl.h
index 15a80dc..867f0e5 100644
--- a/General_Driver/IMU_ctrl.h
+++ b/General_Driver/IMU_ctrl.h
@@ -8,31 +8,105 @@ IMU_ST_SENSOR_DATA stMagnRawData;
 float temp;
 
 
+// This board revision has no QMI8658 (WhoAmI reads 0xff on both addresses);
+// it is the older revision carrying an ICM20948 (WHO_AM_I 0xEA at 0x68/0x69),
+// so the QMI8658+AK09918 stack is replaced by an ICM20948 read path feeding
+// the same AHRS fusion. The chip is probed ONCE at boot with a bounded
+// transaction: if nothing answers, the bus is never touched again — a missing
+// chip's I2C timeouts would throttle the whole main loop — and r/p/y stay 0.0
+// with temp falling back to the ESP32 internal sensor.
+
+#define ICM20948_WHOAMI_REG 0x00
+#define ICM20948_WHOAMI_VAL 0xEA
+// Unthrottled back-to-back reads would starve the ~1ms command loop; the
+// AK09916 inside the ICM20948 tops out at 100Hz anyway.
+#define IMU_READ_INTERVAL_MS 10
+
+Adafruit_ICM20948 icm20948_imu;
+bool imuOnline = false;
+unsigned long lastImuReadMs = 0;
+unsigned long lastFusionUs = 0;
+
+extern float q0, q1, q2, q3;  // AHRS quaternion state (IMU.cpp)
+
+bool icmProbe(uint8_t addr) {
+	Wire.beginTransmission(addr);
+	Wire.write(ICM20948_WHOAMI_REG);  // bank 0 is selected out of reset
+	if (Wire.endTransmission(false) != 0) return false;
+	if (Wire.requestFrom((int)addr, 1) != 1) return false;
+	return Wire.read() == ICM20948_WHOAMI_VAL;
+}
+
 void imu_init() {
-	imuInit();
+	uint8_t addr;
+	if (icmProbe(0x68))      addr = 0x68;
+	else if (icmProbe(0x69)) addr = 0x69;
+	else {
+		Serial.println("imu: no ICM20948 at 0x68/0x69, IMU disabled");
+		return;
+	}
+	if (!icm20948_imu.begin_I2C(addr)) {
+		Serial.printf("imu: ICM20948 at 0x%02X failed to init, IMU disabled\r\n", addr);
+		return;
+	}
+	icm20948_imu.setAccelRange(ICM20948_ACCEL_RANGE_4_G);
+	icm20948_imu.setGyroRange(ICM20948_GYRO_RANGE_500_DPS);
+	icm20948_imu.setMagDataRate(AK09916_MAG_DATARATE_100_HZ);
+	// Every device on this bus (ICM20948, SSD1306, INA219) is 400kHz-capable,
+	// and at 100kHz one full IMU read costs ~4ms of loop time.
+	Wire.setClock(400000);
+	q0 = 1.0f; q1 = 0.0f; q2 = 0.0f; q3 = 0.0f;
+	imuOnline = true;
+	Serial.printf("imu: ICM20948 online at 0x%02X\r\n", addr);
 }
 
 
 void updateIMUData() {
-	imuDataGet( &stAngles, &stGyroRawData, &stAccelRawData, &stMagnRawData);
-
-	ax = stAccelRawData.X;
-	ay = stAccelRawData.Y;
-	az = stAccelRawData.Z;
-
-	mx = stMagnRawData.s16X;
-	my = stMagnRawData.s16Y;
-	mz = stMagnRawData.s16Z;
-
-	gx = stGyroRawData.X;
-	gy = stGyroRawData.Y;
-	gz = stGyroRawData.Z;
-
-	icm_roll = stAngles.roll;
-	icm_pitch = stAngles.pitch;
-	icm_yaw = stAngles.yaw;
-
-  temp = temperatureRead();
+	if (!imuOnline) {
+		temp = temperatureRead();
+		return;
+	}
+	unsigned long nowMs = millis();
+	if (nowMs - lastImuReadMs < IMU_READ_INTERVAL_MS) return;
+	lastImuReadMs = nowMs;
+
+	sensors_event_t accelEvt, gyroEvt, tempEvt, magEvt;
+	if (!icm20948_imu.getEvent(&accelEvt, &gyroEvt, &tempEvt, &magEvt)) return;
+
+	// Adafruit reports SI units (m/s^2, rad/s, uT). The fusion normalizes
+	// accel and mag, so only the gyro units (rad/s) and a consistent frame
+	// matter. The AK09916 mag frame is (x, -y, -z) of the accel/gyro frame.
+	float fmx = magEvt.magnetic.x;
+	float fmy = -magEvt.magnetic.y;
+	float fmz = -magEvt.magnetic.z;
+
+	unsigned long nowUs = micros();
+	float dt = (lastFusionUs == 0) ? 0.01f : (nowUs - lastFusionUs) * 1e-6f;
+	lastFusionUs = nowUs;
+	if (dt > 0.05f) dt = 0.05f;
+
+	imuAHRSupdate(gyroEvt.gyro.x, gyroEvt.gyro.y, gyroEvt.gyro.z,
+	              accelEvt.acceleration.x, accelEvt.acceleration.y, accelEvt.acceleration.z,
+	              fmx, fmy, fmz, dt * 0.5f);
+
+	icm_pitch = asin(-2 * q1 * q3 + 2 * q0 * q2) * 57.3;
+	icm_roll  = atan2(2 * q2 * q3 + 2 * q0 * q1, -2 * q1 * q1 - 2 * q2 * q2 + 1) * 57.3;
+	icm_yaw   = atan2(-2 * q1 * q2 - 2 * q0 * q3, 2 * q2 * q2 + 2 * q3 * q3 - 1) * 57.3;
+
+	// feedback globals keep the historical units: mg, deg/s, raw mag
+	ax = accelEvt.acceleration.x * (1000.0f / SENSORS_GRAVITY_STANDARD);
+	ay = accelEvt.acceleration.y * (1000.0f / SENSORS_GRAVITY_STANDARD);
+	az = accelEvt.acceleration.z * (1000.0f / SENSORS_GRAVITY_STANDARD);
+
+	gx = gyroEvt.gyro.x * RAD_TO_DEG;
+	gy = gyroEvt.gyro.y * RAD_TO_DEG;
+	gz = gyroEvt.gyro.z * RAD_TO_DEG;
+
+	mx = fmx;
+	my = fmy;
+	mz = fmz;
+
+	temp = tempEvt.temperature;  // IMU die temp; tracks ambient far better than the ESP32 core
 }
 
 
